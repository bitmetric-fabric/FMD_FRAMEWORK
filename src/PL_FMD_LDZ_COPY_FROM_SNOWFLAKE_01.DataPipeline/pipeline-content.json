            {
              "name": "SC_COPY_INTO_LANDINGZONE",
              "type": "Script",
              "dependsOn": [
                {
                  "activity": "LK_GET_LASTLOADDATE",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "description": "Snowflake schrijft de entiteit als parquet in de landing zone (COPY INTO via storage integration, zie ADR-014).",
              "typeProperties": {
                "connectionVersion": "1.1",
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "COPY INTO 'azure://onelake.blob.fabric.microsoft.com/@{item().WorkspaceGuid}/@{item().TargetLakehouseGuid}/Files/@{item().TargetFilePath}/@{item().TargetFileName}/' FROM (@{item().SourceDataRetrieval}) STORAGE_INTEGRATION = @{pipeline().libraryVariables.VAR_FMD_snowflake_storage_integration} FILE_FORMAT = (TYPE = PARQUET) HEADER = TRUE OVERWRITE = TRUE MAX_FILE_SIZE = 268435456",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "externalReferences": {
                "connection": "@item().ConnectionGuid",
                "connectionType": "Snowflake"
              }
            },
