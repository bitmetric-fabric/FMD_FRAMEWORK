            {
                "name": "SW_CONNECTION_TYPE",
                "description": "Een activiteit binnen de Switch mag geen dependsOn hebben op een activiteit erbuiten: de run faalt dan direct met een lege BadRequest, nul activiteiten (getest in FMD_TRIAL, 2026-10-13, ADR-018). Daarom hangt de Switch af van LKP_CONNECTION, en de eerste activiteit in elke case niet. Een expressie als @activity('LKP_CONNECTION').output binnen de Switch werkt wel.",
                "type": "Switch",
                "dependsOn": [
                    {
                        "activity": "LKP_CONNECTION",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "on": {
                        "value": "@activity('LKP_CONNECTION').output.firstRow.ConnectionType",
                        "type": "Expression"
                    },
                    "cases": [
                        {
                            "value": "SQL",
                            "activities": [
                                {
                                    "name": "LKP_METADATA_SQL",
                                    "description": "Reads sys.objects/sys.columns/sys.indexes from the source database. One row with one JSON array, shaped for sp_UpsertDiscoveredEntities.",
                                    "type": "Lookup",
                                    "dependsOn": [],
                                    "policy": {
                                        "timeout": "0.01:00:00",
                                        "retry": 1,
                                        "retryIntervalInSeconds": 30,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "typeProperties": {
                                        "source": {
                                            "type": "AzureSqlSource",
                                            "sqlReaderQuery": {
                                                "value": "DECLARE @SchemaFilter SYSNAME = NULLIF(N'@{pipeline().parameters.SchemaFilter}', N'');\n\nSELECT ISNULL((\n    SELECT\n        SCHEMA_NAME(o.schema_id) AS SourceSchema,\n        o.[name] AS SourceName,\n        CASE o.[type] WHEN 'U' THEN 'U' ELSE 'V' END AS ObjectType,\n        PrimaryKeys = (\n            SELECT STRING_AGG(c.[name], ',') WITHIN GROUP (ORDER BY ic.key_ordinal)\n            FROM sys.indexes i\n            JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id\n            JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id\n            WHERE i.object_id = o.object_id AND i.is_primary_key = 1\n        ),\n        Columns = (\n            SELECT c.[name] AS [Name], TYPE_NAME(c.system_type_id) AS [Type]\n            FROM sys.columns c\n            WHERE c.[object_id] = o.object_id\n            ORDER BY c.column_id\n            FOR JSON PATH\n        )\n    FROM sys.objects o\n    WHERE o.[type] IN ('U', 'V')\n      AND (@SchemaFilter IS NULL OR SCHEMA_NAME(o.schema_id) = @SchemaFilter)\n    FOR JSON PATH\n), '[]') AS [Json];",
                                                "type": "Expression"
                                            },
                                            "queryTimeout": "02:00:00",
                                            "partitionOption": "None"
                                        },
                                        "firstRowOnly": true,
                                        "datasetSettings": {
                                            "annotations": [],
                                            "type": "AzureSqlTable",
                                            "schema": [],
                                            "typeProperties": {
                                                "database": {
                                                    "value": "@pipeline().parameters.DataSourceName",
                                                    "type": "Expression"
                                                }
                                            },
                                            "externalReferences": {
                                                "connection": "@activity('LKP_CONNECTION').output.firstRow.ConnectionGuid"
                                            }
                                        }
                                    }
                                },
                                {
                                    "name": "SP_UPSERT_DISCOVERED_SQL",
                                    "type": "SqlServerStoredProcedure",
                                    "dependsOn": [
                                        {
                                            "activity": "LKP_METADATA_SQL",
                                            "dependencyConditions": [
                                                "Succeeded"
                                            ]
                                        }
                                    ],
                                    "policy": {
                                        "timeout": "0.01:00:00",
                                        "retry": 0,
                                        "retryIntervalInSeconds": 30,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "typeProperties": {
                                        "storedProcedureName": "[integration].[sp_UpsertDiscoveredEntities]",
                                        "storedProcedureParameters": {
                                            "ConnectionName": {
                                                "value": {
                                                    "value": "@pipeline().parameters.ConnectionName",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
