                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            },
                                            "SchemaFilter": {
                                                "value": {
                                                    "value": "@if(equals(pipeline().parameters.SchemaFilter, ''), null, pipeline().parameters.SchemaFilter)",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            },
                                            "Json": {
                                                "value": {
                                                    "value": "@activity('LKP_METADATA_SQL').output.firstRow.Json",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            }
                                        }
                                    },
                                    "connectionSettings": {
                                        "name": "SQL_FMD_FRAMEWORK",
                                        "properties": {
                                            "annotations": [],
                                            "type": "FabricSqlDatabase",
                                            "typeProperties": {
                                                "workspaceId": "@pipeline().libraryVariables.VAR_CONFIG_FMD_fmd_config_workspace_guid",
                                                "artifactId": "@pipeline().libraryVariables.VAR_CONFIG_FMD_fmd_config_database_guid"
                                            },
                                            "externalReferences": {
                                                "connection": "372237f9-709a-48f8-8fb2-ce06940c990e"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "value": "SNOWFLAKE",
                            "activities": [
                                {
                                    "name": "SC_METADATA_SNOWFLAKE",
                                    "description": "Getest in FMD_TRIAL, 2026-10-13: twee losse scripts[]-items deelden geen sessie, RESULT_SCAN(LAST_QUERY_ID(-1)) vond de SHOW PRIMARY KEYS van daarvoor niet ('invalid identifier'). Een puntkomma-gescheiden string in één scripts[]-item werkt wel. KEY_COLUMN_USAGE bestaat niet in Snowflake's INFORMATION_SCHEMA (alleen TABLE_CONSTRAINTS); SHOW PRIMARY KEYS + RESULT_SCAN is de juiste route. NIET GETEST: de index van resultSets voor de EXEC hieronder (welk element de JSON van de laatste SELECT bevat).",
                                    "type": "Script",
                                    "dependsOn": [],
                                    "policy": {
                                        "timeout": "0.01:00:00",
                                        "retry": 0,
                                        "retryIntervalInSeconds": 30,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "typeProperties": {
                                        "connectionVersion": "1.1",
                                        "scripts": [
                                            {
                                                "type": "Query",
                                                "text": {
                                                    "value": "SHOW PRIMARY KEYS IN DATABASE \"@{pipeline().parameters.DataSourceName}\";\nWITH pk AS (\n    SELECT \"schema_name\" AS SCHEMA_NAME, \"table_name\" AS TABLE_NAME,\n           LISTAGG(\"column_name\", ',') WITHIN GROUP (ORDER BY \"key_sequence\") AS PK_COLUMNS\n    FROM TABLE(RESULT_SCAN(LAST_QUERY_ID(-1)))\n    GROUP BY 1, 2\n),\ncols AS (\n    SELECT c.table_schema AS SCHEMA_NAME, c.table_name AS TABLE_NAME, MAX(t.table_type) AS TABLE_TYPE,\n           ARRAY_AGG(OBJECT_CONSTRUCT('Name', c.column_name, 'Type', c.data_type)) WITHIN GROUP (ORDER BY c.ordinal_position) AS COLUMNS\n    FROM \"@{pipeline().parameters.DataSourceName}\".information_schema.columns c\n    JOIN \"@{pipeline().parameters.DataSourceName}\".information_schema.tables t\n      ON t.table_schema = c.table_schema AND t.table_name = c.table_name\n    WHERE c.table_schema = COALESCE(NULLIF('@{pipeline().parameters.SchemaFilter}', ''), c.table_schema)\n    GROUP BY 1, 2\n)\nSELECT TO_VARCHAR(ARRAY_AGG(OBJECT_CONSTRUCT(\n    'SourceSchema', cols.SCHEMA_NAME,\n    'SourceName', cols.TABLE_NAME,\n    'ObjectType', IFF(cols.TABLE_TYPE = 'VIEW', 'V', 'U'),\n    'Columns', cols.COLUMNS,\n    'PrimaryKeys', pk.PK_COLUMNS\n))) AS \"Json\"\nFROM cols\nLEFT JOIN pk ON pk.SCHEMA_NAME = cols.SCHEMA_NAME AND pk.TABLE_NAME = cols.TABLE_NAME;",
                                                    "type": "Expression"
                                                }
                                            }
                                        ],
                                        "scriptBlockExecutionTimeout": "02:00:00"
                                    },
                                    "externalReferences": {
                                        "connection": "@activity('LKP_CONNECTION').output.firstRow.ConnectionGuid",
                                        "connectionType": "Snowflake"
                                    }
                                },
                                {
                                    "name": "SP_UPSERT_DISCOVERED_SNOWFLAKE",
                                    "type": "SqlServerStoredProcedure",
                                    "dependsOn": [
                                        {
                                            "activity": "SC_METADATA_SNOWFLAKE",
                                            "dependencyConditions": [
                                                "Succeeded"
                                            ]
                                        }
                                    ],
                                    "policy": {
                                        "timeout": "0.01:00:00",
                                        "retry": 0,
                                        "retryIntervalInSeconds": 30,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "typeProperties": {
                                        "storedProcedureName": "[integration].[sp_UpsertDiscoveredEntities]",
                                        "storedProcedureParameters": {
                                            "ConnectionName": {
                                                "value": {
                                                    "value": "@pipeline().parameters.ConnectionName",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            },
                                            "DataSourceName": {
                                                "value": {
                                                    "value": "@pipeline().parameters.DataSourceName",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            },
                                            "SchemaFilter": {
                                                "value": {
                                                    "value": "@if(equals(pipeline().parameters.SchemaFilter, ''), null, pipeline().parameters.SchemaFilter)",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            },
                                            "Json": {
                                                "value": {
                                                    "value": "@activity('SC_METADATA_SNOWFLAKE').output.resultSets[0].rows[0].Json",
                                                    "type": "Expression"
                                                },
                                                "type": "String"
                                            }
                                        }
                                    },
                                    "connectionSettings": {
                                        "name": "SQL_FMD_FRAMEWORK",
                                        "properties": {
                                            "annotations": [],
                                            "type": "FabricSqlDatabase",
                                            "typeProperties": {
                                                "workspaceId": "@pipeline().libraryVariables.VAR_CONFIG_FMD_fmd_config_workspace_guid",
                                                "artifactId": "@pipeline().libraryVariables.VAR_CONFIG_FMD_fmd_config_database_guid"
                                            },
                                            "externalReferences": {
                                                "connection": "372237f9-709a-48f8-8fb2-ce06940c990e"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
