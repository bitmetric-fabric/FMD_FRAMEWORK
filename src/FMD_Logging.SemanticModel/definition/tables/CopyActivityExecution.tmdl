table CopyActivityExecution

	/// Raw event-grain rows - kept for the Run Explorer detail page's event timeline
	column WorkspaceGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: WorkspaceGuid

	column PipelineRunGuid
		dataType: string
		summarizeBy: none
		sourceColumn: PipelineRunGuid

	column PipelineParentRunGuid
		dataType: string
		summarizeBy: none
		sourceColumn: PipelineParentRunGuid

	column PipelineGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: PipelineGuid

	column CopyActivityName
		dataType: string
		summarizeBy: none
		sourceColumn: CopyActivityName

	column CopyActivityParameters
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CopyActivityParameters

	column EntityId
		dataType: int64
		summarizeBy: none
		sourceColumn: EntityId

	column EntityLayer
		dataType: string
		summarizeBy: none
		sourceColumn: EntityLayer

	column TriggerType
		dataType: string
		summarizeBy: none
		sourceColumn: TriggerType

	column TriggerGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: TriggerGuid

	column TriggerTime
		dataType: dateTime
		summarizeBy: none
		formatString: General Date
		sourceColumn: TriggerTime

	column LogType
		dataType: string
		summarizeBy: none
		sourceColumn: LogType

	column LogDateTime
		dataType: dateTime
		summarizeBy: none
		formatString: General Date
		sourceColumn: LogDateTime

	column LogData
		dataType: string
		summarizeBy: none
		sourceColumn: LogData

	partition CopyActivityExecution = m
		mode: import
		source =
			let
				Source = Sql.Database(#"Server", #"Database"),
				logging_CopyActivityExecution = Source{[Schema="logging", Item="CopyActivityExecution"]}[Data]
			in
				logging_CopyActivityExecution
