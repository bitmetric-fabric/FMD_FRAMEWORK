table FactCopyActivityRun

	/// Number of copy activity executions in the current filter context (grain: one row per pipeline run + copy activity + entity)
	measure 'Copy Activity Run Count' = COUNTROWS(FactCopyActivityRun)
		formatString: #,##0

	measure 'Failed Copy Activity Runs' = CALCULATE(COUNTROWS(FactCopyActivityRun), FactCopyActivityRun[FinalStatus] = "Failed")
		formatString: #,##0

	measure 'Copy Activity Success Rate %' = ```
			DIVIDE(
			    CALCULATE(COUNTROWS(FactCopyActivityRun), FactCopyActivityRun[FinalStatus] = "Succeeded"),
			    CALCULATE(COUNTROWS(FactCopyActivityRun), FactCopyActivityRun[FinalStatus] <> "Running/Unknown")
			)
			```
		formatString: 0.0%

	measure 'Avg Copy Activity Duration (sec)' = AVERAGE(FactCopyActivityRun[DurationSeconds])
		formatString: #,##0

	column PipelineRunGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: PipelineRunGuid

	column CopyActivityName
		dataType: string
		summarizeBy: none
		sourceColumn: CopyActivityName

	column EntityId
		dataType: int64
		summarizeBy: none
		sourceColumn: EntityId

	column WorkspaceGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: WorkspaceGuid

	column PipelineParentRunGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: PipelineParentRunGuid

	column PipelineGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: PipelineGuid

	column EntityLayer
		dataType: string
		summarizeBy: none
		sourceColumn: EntityLayer

	column TriggerType
		dataType: string
		summarizeBy: none
		sourceColumn: TriggerType

	column TriggerGuid
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: TriggerGuid

	column StartTime
		dataType: dateTime
		summarizeBy: none
		formatString: General Date
		sourceColumn: StartTime

	column EndTime
		dataType: dateTime
		summarizeBy: none
		formatString: General Date
		sourceColumn: EndTime

	column LastLogTime
		dataType: dateTime
		isHidden
		summarizeBy: none
		formatString: General Date
		sourceColumn: LastLogTime

	column HasFailed
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: HasFailed

	/// LogData.Message is a JSON OBJECT for copy activity failures (unlike the plain string used by pipeline failures) - extracts Message.message, the human-readable text (e.g. the DMTS_EntityNotFoundOrUnauthorized connection error)
	column ErrorMessage
		dataType: string
		summarizeBy: none
		sourceColumn: ErrorMessage

	column ErrorCode
		dataType: string
		summarizeBy: none
		sourceColumn: ErrorCode

	column FinalStatus
		dataType: string
		summarizeBy: none
		sourceColumn: FinalStatus

	column DurationSeconds
		dataType: int64
		summarizeBy: none
		formatString: #,##0
		sourceColumn: DurationSeconds

	column EntityName
		dataType: string
		summarizeBy: none
		sourceColumn: EntityName

	/// Calendar-day of StartTime, used only for the relationship to DimDate
	column StartDate = DATE(YEAR([StartTime]), MONTH([StartTime]), DAY([StartTime]))
		dataType: dateTime
		isHidden
		formatString: General Date
		summarizeBy: none

	partition FactCopyActivityRun = m
		mode: import
		source =
			let
				Source = Sql.Database(#"Server", #"Database"),
				// 87 of 246 raw End-event rows have malformed LogData (a trailing comma before the closing brace - a live source-side logging bug); ISJSON guards every JSON_VALUE call so those rows degrade to null instead of failing the query
				Query = Value.NativeQuery(Source, "WITH agg AS (#(lf)  SELECT#(lf)    PipelineRunGuid, CopyActivityName, EntityId,#(lf)    MAX(WorkspaceGuid) as WorkspaceGuid,#(lf)    MAX(PipelineParentRunGuid) as PipelineParentRunGuid,#(lf)    MAX(PipelineGuid) as PipelineGuid,#(lf)    MAX(EntityLayer) as EntityLayer,#(lf)    MAX(CASE WHEN TriggerType = '1' THEN 'Scheduled' WHEN TriggerType = 'Manual' THEN 'Manual' ELSE TriggerType END) as TriggerType,#(lf)    MAX(TriggerGuid) as TriggerGuid,#(lf)    MIN(CASE WHEN LogType = 'StartCopyActivity' THEN LogDateTime END) as StartTime,#(lf)    MAX(CASE WHEN LogType = 'EndCopyActivity' THEN LogDateTime END) as EndTime,#(lf)    MAX(LogDateTime) as LastLogTime,#(lf)    MAX(CASE WHEN LogType = 'FailedCopyActivity' THEN 1 ELSE 0 END) as HasFailed,#(lf)    MAX(CASE WHEN LogType = 'FailedCopyActivity' AND ISJSON(LogData) = 1#(lf)          THEN COALESCE(JSON_VALUE(LogData,'$.Message.message'), JSON_VALUE(LogData,'$.Message')) END) as ErrorMessage,#(lf)    MAX(CASE WHEN LogType = 'FailedCopyActivity' AND ISJSON(LogData) = 1#(lf)          THEN JSON_VALUE(LogData,'$.Message.errorCode') END) as ErrorCode#(lf)  FROM logging.CopyActivityExecution#(lf)  GROUP BY PipelineRunGuid, CopyActivityName, EntityId#(lf))#(lf)SELECT a.PipelineRunGuid, a.CopyActivityName, a.EntityId, a.WorkspaceGuid, a.PipelineParentRunGuid, a.PipelineGuid, a.EntityLayer, a.TriggerType, a.TriggerGuid,#(lf)  a.StartTime, a.EndTime, a.LastLogTime, a.HasFailed, a.ErrorMessage, a.ErrorCode,#(lf)  CASE WHEN a.HasFailed = 1 THEN 'Failed' WHEN a.EndTime IS NOT NULL THEN 'Succeeded' ELSE 'Running/Unknown' END as FinalStatus,#(lf)  DATEDIFF(SECOND, a.StartTime, a.EndTime) as DurationSeconds,#(lf)  CASE#(lf)    WHEN a.EntityLayer = 'Landingzone' THEN ldz.SourceSchema + '.' + ldz.SourceName#(lf)    WHEN a.EntityLayer = 'Bronze' THEN brz.[Schema] + '.' + brz.Name#(lf)    WHEN a.EntityLayer = 'Silver' THEN slv.[Schema] + '.' + slv.Name#(lf)    ELSE NULL#(lf)  END as EntityName#(lf)FROM agg a#(lf)LEFT JOIN integration.LandingzoneEntity ldz ON a.EntityLayer='Landingzone' AND ldz.LandingzoneEntityId = a.EntityId#(lf)LEFT JOIN integration.BronzeLayerEntity brz ON a.EntityLayer='Bronze' AND brz.BronzeLayerEntityId = a.EntityId#(lf)LEFT JOIN integration.SilverLayerEntity slv ON a.EntityLayer='Silver' AND slv.SilverLayerEntityId = a.EntityId", null, [EnableFolding=false])
			in
				Query
